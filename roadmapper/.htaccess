# roadmapper/ holds all backend code, the secret (.env), the SQLite database and
# the session files. It is meant to live OUTSIDE the web document root (a sibling
# of public/), so nothing here should ever be reachable by URL.
#
# This file is defense in depth: if roadmapper/ ever ends up inside a served path
# (e.g. a host that can't place folders above the docroot, so you drop it into
# public_html), deny every HTTP request so source, secret and DB can't be browsed
# or downloaded. The app is unaffected — public/sync.php reaches api.php through a
# filesystem require(), which Apache access rules never touch.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 and earlier
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Never list directory contents, regardless of the above.
Options -Indexes
