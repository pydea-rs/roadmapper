# Roadmaps — environment template.
# Copy this to `.env` (which is gitignored) and fill in your own hash.
#
# Generate the bcrypt hash of your chosen secret with:
#   php -r 'echo password_hash("your-secret-here", PASSWORD_DEFAULT), "\n";'
# then paste the printed value after JOURNEY_PASSWORD_HASH= below.

JOURNEY_PASSWORD_HASH=

# How many days a successful unlock stays valid before the app re-prompts.
SESSION_EXPIRY_DAYS=7
